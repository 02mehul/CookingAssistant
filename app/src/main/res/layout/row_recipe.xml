<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="8dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <ImageView android:id="@+id/img"
        android:layout_width="match_parent" android:layout_height="160dp"
        android:scaleType="centerCrop"/>

    <TextView android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:paddingTop="6dp" android:text="Recipe"/>
    <TextView android:id="@+id/category"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Category"/>
</LinearLayout>
