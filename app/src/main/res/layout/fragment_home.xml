<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

        <!-- Hero card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:background="#FFEFEA" android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView android:id="@+id/txtWelcome" android:text="Welcome to Cooking Assistant"
                android:textStyle="bold" android:textSize="18sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/txtQuickTip" android:text="Tip: Keep pantry updated for better suggestions!"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp"/>
        </LinearLayout>

        <!-- Gauge -->
        <com.example.cookingassistant.ui.PantryGaugeView
            android:id="@+id/gauge" android:layout_width="match_parent"
            android:layout_height="200dp" android:layout_marginBottom="12dp"/>

        <!-- Quick stats row -->
        <LinearLayout android:id="@+id/rowStats" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="8dp">
            <TextView android:id="@+id/txtItemsTotal" android:text="Items: 0"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/txtItemsLow" android:text="Low: 0"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        </LinearLayout>

        <!-- CTA buttons -->
        <Button android:id="@+id/btnToPantry" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open Pantry"/>
        <Button android:id="@+id/btnToRecipes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Browse Recipes" android:layout_marginTop="8dp"/>

        <!-- Surprise me -->
        <Button android:id="@+id/btnSurprise" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Surprise Me Recipe" android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
